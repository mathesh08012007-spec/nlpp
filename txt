from collections import Counter
import math

sentences = ["I love Python", "I love programming", "Python is easy"]

# 1. PREPROCESS: Build global lists for the entire corpus
all_words = []
all_bigrams = []
all_trigrams = []

for sentence in sentences:
    tokens = sentence.lower().split()
    all_words.extend(tokens)

    # Generate Bigrams
    for i in range(len(tokens) - 1):
        all_bigrams.append((tokens[i], tokens[i + 1]))

    # Generate Trigrams
    for i in range(len(tokens) - 2):
        all_trigrams.append((tokens[i], tokens[i + 1], tokens[i + 2]))

# Create global count dictionaries
unigram_counts = Counter(all_words)
bigram_counts = Counter(all_bigrams)
trigram_counts = Counter(all_trigrams)

total_words = len(all_words)

# ==========================================
# 2. UNIGRAM PROBABILITIES
# ==========================================
print("UNIGRAM PROBABILITIES")
for word in unigram_counts:
    p = unigram_counts[word] / total_words
    print(f"{word} = {round(p, 3)}")

# ==========================================
# 3. BIGRAM PROBABILITIES
# ==========================================
print("\nBIGRAM PROBABILITIES")
for bigram in bigram_counts:
    w1, w2 = bigram
    # P(w2 | w1) = Count(w1, w2) / Count(w1)
    p = bigram_counts[bigram] / unigram_counts[w1]
    print(f"{w1} {w2} = {round(p, 3)}")

# ==========================================
# 4. TRIGRAM PROBABILITIES
# ==========================================
print("\nTRIGRAM PROBABILITIES")
for trigram in trigram_counts:
    w1, w2, w3 = trigram
    # P(w3 | w1, w2) = Count(w1, w2, w3) / Count(w1, w2)
    p = trigram_counts[trigram] / bigram_counts[(w1, w2)]
    print(f"{w1} {w2} {w3} = {round(p, 3)}")

# ==========================================
# 5. PERPLEXITY CALCULATION (Example Sentence)
# ==========================================
print("\nPERPLEXITY")

# Let's find bigram perplexity for: "I love Python"
test_sentence = "I love Python".lower().split()

# Extract bigram pairs to evaluate: [('i', 'love'), ('love', 'python')]
test_bigrams = [
    (test_sentence[i], test_sentence[i + 1])
    for i in range(len(test_sentence) - 1)
]

# Multiply probabilities of the bigrams found in our dataset
product = 1.0
for bg in test_bigrams:
    w1, w2 = bg
    p = bigram_counts[bg] / unigram_counts[w1]
    product *= p

# N is the number of tokens evaluated
N = len(test_sentence)
perplexity = product ** (-1 / N)

print("Sentence: 'I love Python'")
print("Perplexity =", round(perplexity, 3))




