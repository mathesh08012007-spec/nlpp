import nltk
import torch
from nltk.translate.bleu_score import SmoothingFunction, sentence_bleu
from transformers import MarianMTModel, MarianTokenizer

# 1. Setup the Local Marian Model for English to Italian
model_name = "Helsinki-NLP/opus-mt-en-it"

print("Loading MarianMT model from Hugging Face...")
tokenizer = MarianTokenizer.from_pretrained(model_name)
model = MarianMTModel.from_pretrained(model_name)

# 2. Input Method: Prompt user for text
text_to_translate = input("\nEnter the English text to translate: ")

try:
    # Tokenize input text and generate translation
    inputs = tokenizer(text_to_translate, return_tensors="pt", padding=True)

    with torch.no_grad():
        translated_tokens = model.generate(**inputs)

    # Decode tokens back into Italian text
    machine_translated_text = tokenizer.decode(translated_tokens[0], skip_special_tokens=True)

    print(f"\n[English Input]: {text_to_translate}")
    print(f"[Italian Translation]: {machine_translated_text}")

    # 3. Quality Evaluation (BLEU Score)
    print("\nTo calculate the BLEU score, enter a trusted human translation.")
    reference_input = input("Enter human reference translation in Italian: ")

    # Tokenize the strings into lists of words for NLTK precision parsing
    # Lowercasing helps normalize matches for evaluation
    reference_tokens = [reference_input.lower().split()]
    candidate_tokens = machine_translated_text.lower().split()

    # Use a smoothing function to handle short sentences without zeroing out scores
    smoothie = SmoothingFunction().method1
    bleu_score = sentence_bleu(reference_tokens, candidate_tokens, smoothing_function=smoothie)

    # 4. Quality Metrics Display
    print(f"\n--- Quality Metrics ---")
    print(f"BLEU Score: {bleu_score:.4f}")

    if bleu_score > 0.7:
        print("Quality Assessment: Excellent match to human reference.")
    elif bleu_score > 0.4:
        print("Quality Assessment: Good/Understandable translation.")
    else:
        print("Quality Assessment: Low overlap. May need manual correction.")

except Exception as e:
    print(f"\nAn error occurred during runtime: {e}")






