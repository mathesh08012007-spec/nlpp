from nltk.translate import AlignedSent
from nltk.translate.ibm_model import IBMModel1
from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction

# Step 1: Training data
data = [
    ("hello", "bonjour"),
    ("how are you", "comment allez vous"),
    ("i am fine", "je vais bien"),
    ("good morning", "bonjour"),
    ("thank you", "merci"),
    ("i love you", "je vous aime"),
    ("good night", "bonne nuit"),
    ("i am happy", "je suis heureux")
]

# Step 2: Prepare parallel sentences
parallel_data = []

for english, french in data:
    aligned = AlignedSent(
        words=french.split(),
        mots=english.split()
    )
    parallel_data.append(aligned)

# Step 3: Train IBM Model 1
model = IBMModel1(parallel_data, 100)

# Step 4: Translation function
def translate(sentence):
    words = sentence.lower().split()
    result = []

    for word in words:
        best_word = None
        best_probability = 0

        for french_word in model.translation_table:
            probability = model.translation_table[french_word].get(word, 0)

            if probability > best_probability:
                best_probability = probability
                best_word = french_word

        if best_word:
            result.append(best_word)
        else:
            result.append("[?]")

    return " ".join(result)

# Step 5: Get input
sentence = input("Enter English sentence: ")

# Step 6: Translate
translation = translate(sentence)

# Step 7: Get reference translation
reference = input("Enter Reference French Translation: ")

# Step 8: Calculate BLEU score
reference_words = reference.lower().split()
candidate_words = translation.lower().split()

bleu = sentence_bleu(
    [reference_words],
    candidate_words,
    smoothing_function=SmoothingFunction().method1
)

# Step 9: Output
print("\n==============================================")
print("             TRANSLATION RESULT")
print("==============================================")

print("English              :", sentence)
print("French Translation   :", translation)
print("Reference Translation:", reference)
print("BLEU Score           :", round(bleu, 3))
print("BLEU Score %         :", round(bleu * 100, 2), "%")

print("\n==============================================")
print("              OUTPUT ANALYSIS")
print("==============================================")

print("Total Words          :", len(sentence.split()))
print("Translated Words     :", len(candidate_words))
print("BLEU Score           :", round(bleu, 3))

if bleu >= 0.5:
    print("Translation Quality  : Good")
elif bleu >= 0.2:
    print("Translation Quality  : Medium")
else:
    print("Translation Quality  : Low")

print("==============================================")











