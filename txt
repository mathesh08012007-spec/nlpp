from nltk import CFG
from nltk.parse import ChartParser

# ---------------------------------------------------------
# 1. Define Grammar
# ---------------------------------------------------------

grammar = CFG.fromstring("""
S -> NP VP
NP -> PRON
NP -> DET NOUN
NP -> DET NOUN PP
VP -> VERB NP
VP -> VERB NP PP
PP -> PREP NP
PRON -> "I"
DET -> "the"
NOUN -> "man" | "telescope"
VERB -> "saw"
PREP -> "with"
""")

# ---------------------------------------------------------
# 2. Create Parser
# ---------------------------------------------------------

parser = ChartParser(grammar)

# ---------------------------------------------------------
# 3. Input Sentence
# ---------------------------------------------------------

sentence = "I saw the man with the telescope".split()

n = len(sentence)

# ---------------------------------------------------------
# 4. Create CKY Table
# ---------------------------------------------------------

table = [[set() for j in range(n)] for i in range(n)]

# ---------------------------------------------------------
# 5. Add POS categories to diagonal cells
# ---------------------------------------------------------

word_categories = {
    "I": {"PRON"},
    "saw": {"VERB"},
    "the": {"DET"},
    "man": {"NOUN"},
    "with": {"PREP"},
    "telescope": {"NOUN"}
}

for i in range(n):
    table[i][i] = word_categories[sentence[i]].copy()

# ---------------------------------------------------------
# 6. Grammar rules used for CKY table
# ---------------------------------------------------------

binary_rules = {
    ("PRON", "VP"): "S",

    ("DET", "NOUN"): "NP",

    ("DET", "X"): "NP",

    ("VERB", "NP"): "VP",

    ("VERB", "X"): "VP",

    ("PREP", "NP"): "PP",

    ("NOUN", "PP"): "X",

    ("NP", "PP"): "X"
}

# ---------------------------------------------------------
# 7. Fill CKY Table
# ---------------------------------------------------------

for length in range(2, n + 1):

    for i in range(n - length + 1):

        j = i + length - 1

        for k in range(i, j):

            left = table[i][k]
            right = table[k + 1][j]

            for B in left:
                for C in right:

                    if (B, C) in binary_rules:

                        parent = binary_rules[(B, C)]

                        table[i][j].add(parent)


# ---------------------------------------------------------
# 8. Print CKY Table
# ---------------------------------------------------------

print("\n")
print("=" * 110)
print("                         CKY PARSING TABLE")
print("=" * 110)

# Column headings
print(f"{'':<12}", end="")

for word in sentence:
    print(f"{word:<14}", end="")

print()

print("-" * 110)

# Table contents
for i in range(n):

    print(f"{sentence[i]:<12}", end="")

    for j in range(n):

        if i <= j:

            if table[i][j]:
                cell = ",".join(sorted(table[i][j]))
            else:
                cell = "-"

            print(f"{cell:<14}", end="")

        else:
            print(f"{'':<14}", end="")

    print()

print("=" * 110)


# ---------------------------------------------------------
# 9. Display Final Cell
# ---------------------------------------------------------

print("\nFinal Cell [0,6]:")
print(table[0][6])


# ---------------------------------------------------------
# 10. Generate Parse Trees using ChartParser
# ---------------------------------------------------------

trees = list(parser.parse(sentence))

print("\n")
print("=" * 110)
print("                         PARSE TREES")
print("=" * 110)

print("\nNumber of parse trees:", len(trees))

# ---------------------------------------------------------
# 11. Display Parse Trees
# ---------------------------------------------------------

for i, tree in enumerate(trees, 1):

    print("\n" + "-" * 110)
    print("Parse Tree", i)
    print("-" * 110)

    tree.pretty_print()


# ---------------------------------------------------------
# 12. Explain Ambiguity
# ---------------------------------------------------------

print("\n")
print("=" * 110)
print("                         AMBIGUITY")
print("=" * 110)

print("""
Parse Tree 1:
"with the telescope" is attached to the Verb Phrase (VP).

Meaning:
I used the telescope to see the man.


Parse Tree 2:
"with the telescope" is attached to the Noun Phrase (NP).

Meaning:
The man had the telescope.
""")




