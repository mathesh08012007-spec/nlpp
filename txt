import re
import nltk
from nltk.tokenize import sent_tokenize, word_tokenize
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer

# Download required data
nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('stopwords')
nltk.download('wordnet')

# Input text
text = input("Enter the text: ")

# 1. Regular Expression
print("\n1. Regular Expression")
print("Words:", re.findall(r'\b[A-Za-z]+\b', text))
print("Numbers:", re.findall(r'\b\d+\b', text))
print("Emails:", re.findall(r'\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b', text))

# 2. Sentence Tokenization
print("\n2. Sentence Tokenization")
print(sent_tokenize(text))

# 3. Word Tokenization
words = word_tokenize(text)
print("\n3. Word Tokenization")
print(words)

# 4. POS Tagging
print("\n4. POS Tagging")
print(nltk.pos_tag([w for w in words if w.isalpha()]))

# 5. Stop Word Removal
stop_words = set(stopwords.words('english'))
filtered = [w for w in words
            if w.isalpha() and w.lower() not in stop_words]
print("\n5. Stop Word Removal")
print(filtered)

# 6. Stemming
stemmer = PorterStemmer()
stemmed = [stemmer.stem(w) for w in filtered]
print("\n6. Stemming")
print(stemmed)

# 7. Lemmatization
lemmatizer = WordNetLemmatizer()
lemmatized = [lemmatizer.lemmatize(w) for w in filtered]
print("\n7. Lemmatization")
print(lemmatized)

print("\nText preprocessing completed successfully!")



